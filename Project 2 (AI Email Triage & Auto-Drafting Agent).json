      "name": "limit "
    },
    {
      "parameters": {
        "jsCode": "const item = $input.item.json;\n\n// 1. Prefer textPlain; fallback to stripping tags from textHtml\nlet rawBody = item.textPlain || '';\nif (!rawBody && item.textHtml) {\n  rawBody = item.textHtml\n    .replace(/<style[^>]*>[\\s\\S]*?<\\/style>/gi, '')\n    .replace(/<[^>]+>/g, ' ');\n}\n\n// 2. Strip quoted reply history, excessive whitespace, and long tracking URLs\nconst cleanBody = rawBody\n  .split(/\\r?\\nOn .+ wrote:/)[0]          // Cut off quoted reply thread\n  .replace(/https?:\\/\\/\\S{80,}/g, '[link]') // Replace long tracking URLs\n  .replace(/\\s+/g, ' ')\n  .trim()\n  .slice(0, 2500);\n\nreturn {\n  json: {\n    messageId: item.messageId || item.id || '',\n    date: item.date || '',\n    from: item.from || '',\n    subject: item.subject || '(No Subject)',\n    cleanBody\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        -192
      ],
      "id": "a13fdd16-4f53-4418-ac51-f8fcd9d81694",
      "name": "Normalize Email"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Analyze and triage this incoming email:\n\nFrom: {{ $json.from }}\nDate: {{ $json.date }}\nSubject: {{ $json.subject }}\nBody:\n{{ $json.cleanBody }}",
        "options": {
          "systemMessage": "You are an executive email triage and drafting assistant. Analyze the incoming email and return ONLY structured JSON matching the schema.\n\nClassification rules:\n- category: one of [\"urgent_action\", \"opportunity_lead\", \"client_project\", \"notification_social\", \"newsletter_promo\", \"spam\"]\n- priority: \"high\" (deadlines, direct human inquiries, opportunities), \"medium\" (routine follow-ups, standard updates), or \"low\" (automated notifications, social alerts, newsletters, noreply senders).\n- requires_reply: true ONLY when a real human or business expects a direct response. Set false for automated alerts, noreply addresses, LinkedIn notifications, and newsletters.\n- summary: concise 1-2 sentence summary of the email.\n- draft_reply: if requires_reply is true, write a polite, clear, professional reply ready for human review (no placeholder brackets unless strictly necessary). If requires_reply is false, return null.   \n\nReturn the flat JSON object directly with top-level keys: category, priority, requires_reply, summary, draft_reply. Do NOT wrap the JSON inside an \"output\" object"
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        672,
        -192
      ],
      "id": "be428565-61ea-4d6f-96c2-9af2a2d93a28",
